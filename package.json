{
	"name": "retroui-svelte",
	"version": "0.8.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm \"/dev:/\"",
		"dev:content": "velite dev --watch",
		"dev:svelte": "vite dev",
		"build": "velite && node ./scripts/update-velite-output.js && vite build",
		"build:search": "node ./scripts/build-search-data.js",
		"preview": "vite preview",
		"check": "velite && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm build:content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"registry:build": "pnpm shadcn-svelte registry build"
	},
	"devDependencies": {
		"@internationalized/date": "^3.9.0",
		"@lucide/svelte": "^0.542.0",
		"@mdsx/rehype-custom-highlighter": "^0.0.3",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.20.3",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.1.1",
		"@tanstack/table-core": "^8.21.3",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"layerchart": "2.0.0-next.37",
		"mdsx": "^0.0.6",
		"mode-watcher": "^1.1.0",
		"package-manager-detector": "^1.3.0",
		"rehype-pretty-code": "^0.14.1",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"shadcn-svelte": "^1.0.7",
		"svelte": "^5.25.6",
		"svelte-check": "^4.1.5",
		"svelte-sonner": "^1.0.5",
		"svelte-toolbelt": "^0.9.3",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.0",
		"tailwindcss": "^4.1.1",
		"tw-animate-css": "^1.3.7",
		"typescript": "^5.0.0",
		"velite": "^0.2.1",
		"vite": "^6.2.4"
	},
	"dependencies": {
		"@shikijs/langs": "^3.12.0",
		"@shikijs/themes": "^3.12.0",
		"bits-ui": "^2.9.6",
		"shiki": "^3.12.0"
	}
}
