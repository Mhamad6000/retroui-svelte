{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "loader",
	"type": "registry:ui",
	"devDependencies": [
		"tailwind-variants"
	],
	"files": [
		{
			"content": "export { default as Loader } from \"./loader.svelte\";\nexport * from \"./loader.svelte\";\n",
			"type": "registry:file",
			"target": "loader/index.ts"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport { cn, type WithElementRef, type WithoutChildren } from \"$UTILS$.js\";\n\timport { type VariantProps, tv } from \"tailwind-variants\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\texport const loaderVariants = tv({\n\t\tbase: \"flex gap-1\",\n\t\tvariants: {\n\t\t\tvariant: {\n\t\t\t\tdefault: \"[&>div]:bg-primary [&>div]:border-border\",\n\t\t\t\tsecondary: \"[&>div]:bg-black [&>div]:border-border\",\n\t\t\t\toutline: \"[&>div]:bg-transparent [&>div]:border-border\",\n\t\t\t},\n\t\t\tsize: {\n\t\t\t\tsm: \"[&>div]:w-2 [&>div]:h-2\",\n\t\t\t\tmd: \"[&>div]:w-3 [&>div]:h-3\",\n\t\t\t\tlg: \"[&>div]:w-4 [&>div]:h-4\",\n\t\t\t},\n\t\t},\n\t\tdefaultVariants: {\n\t\t\tvariant: \"default\",\n\t\t\tsize: \"md\",\n\t\t},\n\t});\n\n\texport type LoaderVariant = VariantProps<typeof loaderVariants>[\"variant\"];\n\texport type LoaderSize = VariantProps<typeof loaderVariants>[\"size\"];\n\texport type LoaderProps = WithoutChildren<WithElementRef<HTMLAttributes<HTMLDivElement>>> & {\n\t\tvariant?: LoaderVariant;\n\t\tsize?: LoaderSize;\n\t\tcount?: number; // number of bouncing dots\n\t\tduration?: number; // animation duration in seconds\n\t\tdelayStep?: number; // delay in ms\n\t};\n</script>\n\n<script lang=\"ts\">\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tvariant = \"default\",\n\t\tsize = \"md\",\n\t\tcount = 3,\n\t\tduration = 0.5,\n\t\tdelayStep = 100,\n\t\t...restProps\n\t}: LoaderProps = $props();\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"loader\"\n\tclass={cn(loaderVariants({ variant, size }), className)}\n\trole=\"status\"\n\taria-label=\"Loading...\"\n\t{...restProps}\n>\n\t{#each Array.from({ length: count }) as _, i}\n\t\t<div\n\t\t\tclass=\"animate-bounce border-2\"\n\t\t\tstyle=\"animation-duration: {duration}s; animation-iteration-count: infinite; animation-delay: {i *\n\t\t\t\tdelayStep}ms;\"\n\t\t></div>\n\t{/each}\n</div>\n",
			"type": "registry:file",
			"target": "loader/loader.svelte"
		}
	]
